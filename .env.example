# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# PostgreSQL (Supabase pooler — replace YOUR_DB_PASSWORD)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
FOM_DEFAULT_WORKSPACE_SLUG="fom"
CRON_SECRET=""

# Production example:
# NEXT_PUBLIC_APP_URL=https://fucking-scraping-machine.vercel.app
# GOOGLE_OAUTH_REDIRECT_URI=https://fucking-scraping-machine.vercel.app/api/auth/google/callback

# Token encryption (32-byte base64 or hex — generate with: openssl rand -base64 32)
FOM_TOKEN_ENCRYPTION_KEY=""

# Google Cloud — enable Gmail API; API key optional for some calls
GOOGLE_API_KEY=""

# Google OAuth (required for gmail.send — Web application client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Gmail Pub/Sub (reply watch)
GOOGLE_PUBSUB_TOPIC=""
GOOGLE_PUBSUB_VERIFICATION_TOKEN=""

# Tracking signatures
FOM_TRACKING_SIGNING_SECRET=""

# AI providers (optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
